{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "../shared/**/*.ts", "../subpackages/shared/dailyQuestionBank.ts"],
  "exclude": ["src/**/*.test.ts", "../shared/**/*.test.ts", "dist"]
}
