# Compose / 域名
DOMAIN=daykeep.cn
IMAGE_TAG=latest

# PostgreSQL（请替换为独立强密码，不要把真实文件提交到 Git）
POSTGRES_DB=daykeep
POSTGRES_USER=daykeep
POSTGRES_PASSWORD=replace-with-a-long-random-password

# API
JWT_SECRET=replace-with-at-least-32-random-bytes
REFRESH_SECRET=replace-with-another-32-random-bytes

# 个人微信小程序
WX_APPID=
WX_SECRET=
WX_SUBSCRIBE_TEMPLATE_ID=

# 腾讯云 COS：使用仅限目标 Bucket 的子账号密钥
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_PREFIX=daykeep
COS_URL_EXPIRE=3600
# 先将官方头像上传到此对象 key；API 返回时会生成短期签名地址。
OFFICIAL_AVATAR_URL=cos://daykeep/system/official/avatar.png

# 提醒 Worker
REMINDER_SCHEDULER_ENABLED=1
REMINDER_SEND_HOUR=9

# 可选运维告警
ALERT_WEBHOOK_URL=

# 数据库备份
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
