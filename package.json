{
  "name": "daykeep",
  "version": "0.1.0",
  "private": true,
  "description": "只我们 — 和最在乎的人，留下一本只属于我们的生活记录",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:h5": "UNI_INPUT_DIR=. uni",
    "build:h5": "UNI_INPUT_DIR=. uni build",
    "dev:mp-weixin": "UNI_INPUT_DIR=. uni -p mp-weixin",
    "build:mp-weixin": "UNI_INPUT_DIR=. uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5010120260519001",
    "@dcloudio/uni-components": "3.0.0-alpha-5010120260519001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5010120260519001",
    "lunar-javascript": "^1.7.7",
    "pinia": "^2.1.0",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5010120260519001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5010120260519001",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "sass": "^1.70.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.0"
  },
  "license": "MIT",
  "overrides": {
    "vue": "3.4.21",
    "@vue/shared": "3.4.21",
    "@vue/reactivity": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "@vue/compiler-dom": "3.4.21",
    "@vue/compiler-core": "3.4.21",
    "@vue/compiler-sfc": "3.4.21"
  }
}
